VITE_BASE=/

# USR模块接口地址 (用户认证)
VITE_GLOB_API_URL=/api/usr

# CLM模块接口地址 (集群管理)
VITE_CLM_API_URL=/api/clm

# HOM模块接口地址 (主机管理)
VITE_HOM_API_URL=/api/hom

# SVM模块接口地址 (服务管理)
VITE_SVM_API_URL=/api/svm

# MON模块接口地址 (监控告警)
VITE_MON_API_URL=/api/mon

# K8S模块接口地址 (Kubernetes管理)
VITE_K8S_API_URL=/api/k8s

# REG模块接口地址 (仓库管理)
VITE_REG_API_URL=/api/reg

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
