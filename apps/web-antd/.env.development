# 端口号
VITE_PORT=5777

VITE_BASE=/

# USR模块接口地址 (用户认证)
VITE_GLOB_API_URL=/usr

# CLM模块接口地址 (集群管理)
VITE_CLM_API_URL=/clm

# HOM模块接口地址 (主机管理)
VITE_HOM_API_URL=/hom

# SVM模块接口地址 (服务管理)
VITE_SVM_API_URL=/svm

# MON模块接口地址 (监控告警)
VITE_MON_API_URL=/mon

# K8S模块接口地址 (Kubernetes管理)
VITE_K8S_API_URL=/k8s

# REG模块接口地址 (仓库管理)
VITE_REG_API_URL=/reg

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=true

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
